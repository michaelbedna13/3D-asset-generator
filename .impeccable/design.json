  "narrative": {
    "northStar": "The only colour is the artwork.",
    "overview": "RASTR Studio is a tool for judging and exporting pictures, so its interface is the conventional dark professional editor, played straight: the family of Lightroom, Blender and dark Figma. The owner chose this over two bolder directions. Familiarity is the feature. Nothing in the chrome competes with the canvas, and nothing in it tints how the artwork's colours are read.\n The look is chosen before anything else: both looks sit in the top bar at all times. The panel then shows only the groups that act on what is on the canvas.",
    "keyCharacteristics": [
      "Achromatic greys in four steps; state is shown by lightness, never by hue.",
      "One sans family at 12 px with tabular figures; hierarchy by weight.",
      "Sentence-case labels, title-case group names, no upper-case tracking.",
      "Three zones with one job each: sources left, canvas centre, settings right.",
      "One light primary button per tab, at most."
    ],
    "rules": [
      {
        "name": "The Neutral Chrome Rule",
        "body": "No hue in the interface. Colour appears only in the canvas, in thumbnails, and in swatches that show the artwork's own colours.",
        "section": "colors"
      },
      {
        "name": "The Lightness Rule",
        "body": "Selection, hover and focus are steps of lightness. A coloured state would be the first accent, and there is none.",
        "section": "colors"
      },
      {
        "name": "The Weight Rule",
        "body": "Hierarchy comes from weight and from the three text colours, not from size. The scale is deliberately flat, as in the editors this sits beside.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do keep every surface achromatic and show state by lightness.",
      "Do put a control where it acts: view controls under the canvas, look controls in the Look tab, file actions in Export.",
      "Do hide a group that does not apply to the current look.",
      "Do use a segmented control when all options fit on one line; use a select otherwise.",
      "Do write labels in sentence case and name a button by what it does."
    ],
    "donts": [
      "Don't add an accent colour, a gradient, a glow or a tinted grey.",
      "Don't set labels in upper case or in a monospace face.",
      "Don't give a tab more than one primary button.",
      "Don't make a look, a source or an export reachable only after another action.",
      "Don't cover the canvas with interface, except for progress and a toast."
    ]
  }
}